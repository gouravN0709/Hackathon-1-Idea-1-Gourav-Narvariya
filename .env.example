# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API.
# Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secret key (same Dashboard page; not the publishable key).
# Canonical name — do not use NEXT_PUBLIC_. Legacy deploys may use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Optional — leave unset until approved
# NOTIFICATIONS_PROVIDER=resend
# NOTIFICATIONS_API_KEY=
# NOTIFICATIONS_SEND_ENABLED=false
# RATE_LIMIT_BACKEND=distributed
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STAFF_DEMO_RESERVATIONS=true
